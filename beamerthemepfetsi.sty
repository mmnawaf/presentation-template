%% =====================================================================
%% beamerthemepfetsi.sty -- Thème Beamer des soutenances de projet de fin
%%                          d'études (PFE) du Master Traitement du Signal
%%                          et des Images (TSI), M2, Aix-Marseille Université.
%%
%% Utilisation : \usetheme{pfetsi}           (dans soutenance.tex)
%% Option      : \usetheme[intercalaires]{pfetsi}
%%               ajoute une diapositive de transition au début de chaque
%%               section (non comptée dans la numérotation).
%%
%% Les étudiants n'ont PAS à modifier ce fichier : tout se passe dans
%% soutenance.tex. Le thème compare le nombre de diapositives à la durée
%% de l'exposé (8 min + 2 min par étudiant supplémentaire) et affiche un
%% avertissement sur la diapositive de titre en cas de dépassement.
%%
%% Couleurs et logos : charte graphique amU (mise à jour du 18/09/2024).
%% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemepfetsi}[2026/11/05 v1.0 Theme de soutenance PFE Master TSI]

\newif\ifpfetsi@intercalaires
\newif\ifpfetsi@annexe
\DeclareOption{intercalaires}{\pfetsi@intercalairestrue}
\ProcessOptions\relax

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, babel}
\RequirePackage{calc}
\RequirePackage{soul}                   % surlignage de \alert{}
\RequirePackage{appendixnumberbeamer}   % annexes non comptées

% ---------------------------------------------------------------------
% Couleurs de la charte graphique amU
%   bleu  #1F63DE (Pantone 285C) : couleur principale ;
%   jaune #FFFF85 (Pantone 903C) : mise en évidence. Trop clair pour du
%   texte sur fond blanc, il est toujours associé à du texte noir.
% ---------------------------------------------------------------------
\definecolor{tsiBleu}{HTML}{1F63DE}
\definecolor{tsiJaune}{HTML}{FFFF85}
\definecolor{tsiTexte}{HTML}{1A1A1A}
\definecolor{tsiGris}{HTML}{6B7280}
\definecolor{tsiFond}{HTML}{EEF3FC}

\setbeamercolor{normal text}{fg=tsiTexte, bg=white}
\setbeamercolor{structure}{fg=tsiBleu}
\setbeamercolor{alerted text}{fg=tsiTexte, bg=tsiJaune}
\setbeamercolor{example text}{fg=tsiTexte}
\setbeamercolor{frametitle}{fg=white, bg=tsiBleu}
\setbeamercolor{block title}{fg=white, bg=tsiBleu}
\setbeamercolor{block body}{fg=tsiTexte, bg=tsiFond}
\setbeamercolor{block title alerted}{fg=tsiTexte, bg=tsiJaune}
\setbeamercolor{block body alerted}{fg=tsiTexte, bg=tsiJaune!35}
\setbeamercolor{block title example}{fg=tsiBleu, bg=tsiBleu!15}
\setbeamercolor{block body example}{fg=tsiTexte, bg=tsiBleu!5}
\setbeamercolor{footline}{fg=tsiGris}
\setbeamercolor{caption}{fg=tsiGris}
\setbeamercolor{bibliography entry author}{fg=tsiTexte}
\setbeamercolor{bibliography entry title}{fg=tsiTexte}
\setbeamercolor{bibliography entry location}{fg=tsiGris}
\setbeamercolor{bibliography entry note}{fg=tsiGris}

% ---------------------------------------------------------------------
% Polices : Fira Sans et mathématiques sans empattement assorties
% ---------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\IfFileExists{FiraSans.sty}{%
  \usefonttheme{professionalfonts}
  \RequirePackage[sfdefault, lining]{FiraSans}
  \RequirePackage[scaled=0.97]{newtxsf}
}{}
\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{frametitle}{size=\large, series=\bfseries}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{caption}{size=\footnotesize}
\setbeamerfont{section in toc}{size=\normalsize}

% ---------------------------------------------------------------------
% Mise en page générale
% ---------------------------------------------------------------------
\setbeamersize{text margin left=8mm, text margin right=8mm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}{\raggedright\insertcaption\par}
\setbeamertemplate{bibliography item}{\insertbiblabel}
\setbeamertemplate{itemize item}{%
  \raisebox{0.15ex}{\setlength{\fboxsep}{0pt}\setlength{\fboxrule}{0.4pt}%
    \fcolorbox{tsiTexte}{tsiJaune}{\rule{0.75ex}{0pt}\rule{0pt}{0.75ex}}}}
\setbeamertemplate{itemize subitem}{\color{tsiGris}\textendash}
\setbeamertemplate{enumerate item}{%
  \colorbox{tsiJaune}{\color{tsiTexte}\bfseries\insertenumlabel}}
\setbeamertemplate{section in toc}{%
  \makebox[1.8em][l]{\setlength{\fboxsep}{1.5pt}%
    \colorbox{tsiJaune}{\makebox[1em]{\color{tsiTexte}\bfseries
      \inserttocsectionnumber}}}%
  \inserttocsection\par\vspace{0.6mm}}

% \alert{} : texte noir surligné en jaune (le jaune amU est illisible
% comme couleur de texte sur fond blanc)
\sethlcolor{tsiJaune}
\renewcommand<>{\alert}[1]{{\alt#2{\hl{#1}}{#1}}}
\setbeamertemplate{subsection in toc}{}

% Titre de diapositive : bandeau pleine largeur + barre de progression
\newlength{\pfetsi@progression}
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth, ht=7mm, dp=3mm,
                         leftskip=8mm, rightskip=8mm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}%
  \nointerlineskip
  \pfetsi@barreprogression
  \vspace{1mm}%
}
\newcommand{\pfetsi@barreprogression}{%
  \ifpfetsi@annexe
    \setlength{\pfetsi@progression}{0pt}%
  \else
    \ifnum\insertframenumber>\inserttotalframenumber\relax
      \setlength{\pfetsi@progression}{\paperwidth}%
    \else
      \setlength{\pfetsi@progression}{\paperwidth *
        \ratio{\insertframenumber pt}{\inserttotalframenumber pt}}%
    \fi
  \fi
  \begin{beamercolorbox}[wd=\paperwidth]{}%
    \begin{tikzpicture}
      \fill[tsiBleu] (0, 0) rectangle (\paperwidth, 0.8mm);
      \fill[tsiJaune] (0, 0) rectangle (\pfetsi@progression, 0.8mm);
    \end{tikzpicture}%
  \end{beamercolorbox}%
}

% Pied de page : auteurs | section | numéro
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=3mm, dp=3mm,
                         leftskip=8mm, rightskip=8mm]{footline}%
    \usebeamerfont{footline}%
    \makebox[\dimexpr(\paperwidth-16mm)*2/5\relax][l]{\insertshortauthor}%
    \makebox[\dimexpr(\paperwidth-16mm)*2/5\relax][c]{\insertsectionhead}%
    \makebox[\dimexpr(\paperwidth-16mm)/5\relax][r]{%
      \ifpfetsi@annexe Annexe~\insertframenumber
      \else\insertframenumber\,/\,\inserttotalframenumber\fi}%
  \end{beamercolorbox}%
}

% ---------------------------------------------------------------------
% Informations de la diapositive de titre
% ---------------------------------------------------------------------
\newcommand*{\pfetsi@encadrants}{Prénom NOM}
\newcommand*{\pfetsi@formation}{Master Traitement du Signal et des Images
  (TSI), M2\\Projet de fin d'études}
\newcommand*{\pfetsi@etablissement}{Aix-Marseille Université}
\newcommand*{\pfetsi@etudiants}{1}
\newcommand*{\encadrants}[1]{\renewcommand*{\pfetsi@encadrants}{#1}}
\newcommand*{\formation}[1]{\renewcommand*{\pfetsi@formation}{#1}}
\newcommand*{\etablissement}[1]{\renewcommand*{\pfetsi@etablissement}{#1}}
\newcommand*{\nombreetudiants}[1]{\renewcommand*{\pfetsi@etudiants}{#1}}
% Logos de la diapositive de titre :
%   \logoprincipal{fichier} : logotype cartouche amU, placé en bas à droite
%     comme le prévoit la charte (largeur 36 mm, minimum : 35 mm) ;
%   \logos{fichier1, fichier2} : logos partenaires, empilés à sa gauche.
\newcommand*{\pfetsi@logoprincipal}{}
\newcommand*{\pfetsi@logos}{}
\newcommand*{\pfetsi@nblogos}{0}
\newcommand*{\logoprincipal}[1]{\renewcommand*{\pfetsi@logoprincipal}{#1}}
\newcommand*{\logos}[1]{\renewcommand*{\pfetsi@logos}{#1}}

% ---------------------------------------------------------------------
% Durée de l'exposé et nombre de diapositives
%   durée = 8 min pour un étudiant + 2 min par étudiant supplémentaire ;
%   repère : une diapositive par minute environ (titre, « Questions » et
%   annexes non comptés). Le test utilise la compilation précédente.
% ---------------------------------------------------------------------
\newcommand*{\pfetsi@duree}{\the\numexpr 8 + 2 * (\pfetsi@etudiants - 1)\relax}
\newcommand*{\pfetsi@nbdiapos}{%
  \ifcsname mainendframenumber\endcsname
    \csname mainendframenumber\endcsname
  \else
    \inserttotalframenumber
  \fi}
\newcommand{\pfetsi@alerte}{%
  \ifnum\pfetsi@nbdiapos>\pfetsi@duree\relax
    \PackageWarningNoLine{beamerthemepfetsi}{\pfetsi@nbdiapos\space
      diapositives pour \pfetsi@duree\space minutes d'exposé}%
    \par\vspace{5mm}%
    \colorbox{tsiJaune}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      \raggedright\hyphenpenalty=10000\color{tsiTexte}\bfseries\small
      Attention : \pfetsi@nbdiapos~diapositives pour
      \pfetsi@duree~minutes d'exposé (repère : une par minute).}}%
  \fi}

% ---------------------------------------------------------------------
% Diapositive de titre et plan (\diapotitre) : titre à gauche sur fond
% bleu, plan à droite, logo amU en bas à droite.
% ---------------------------------------------------------------------
\newcommand{\pfetsi@fondtitre}{%
  \begin{tikzpicture}
    \useasboundingbox (0, 0) rectangle (\paperwidth, \paperheight);
    \fill[tsiBleu] (0, 0) rectangle (0.5\paperwidth, \paperheight);
    \fill[tsiJaune] (0, 0) rectangle (0.5\paperwidth, 1.2mm);
    \node[anchor=north west, inner sep=0pt, text width=0.5\paperwidth-16mm,
          align=left, text=white] at (8mm, \paperheight-12mm) {%
      {\usebeamerfont{title}\hyphenpenalty=10000\inserttitle\par}%
      \vspace{6mm}%
      {\bfseries\insertauthor\par}%
      \vspace{1.5mm}%
      {\small Encadrement : \pfetsi@encadrants\par}%
    };
    \node[anchor=south west, inner sep=0pt, text width=0.5\paperwidth-16mm,
          align=left, text=white, font=\footnotesize] at (8mm, 9mm) {%
      \pfetsi@formation\\
      \pfetsi@etablissement\\[1.5mm]
      {\bfseries\insertdate}%
    };
    % Logo cartouche amU dans l'angle inférieur droit
    \ifx\pfetsi@logoprincipal\@empty\else
      \node[anchor=south east, inner sep=0pt] at (\paperwidth, 0)
        {\includegraphics[width=36mm]{\pfetsi@logoprincipal}};
    \fi
    % Logos partenaires empilés à gauche du logo amU, centrés sur sa hauteur
    \ifx\pfetsi@logos\@empty\else
      \foreach \pfetsi@f [count=\pfetsi@n] in \pfetsi@logos
        {\xdef\pfetsi@nblogos{\pfetsi@n}}
      \foreach \pfetsi@f [count=\pfetsi@k] in \pfetsi@logos {
        \node[anchor=north east, inner sep=0pt] at ({\paperwidth-40mm},
          {8.65mm + (\pfetsi@nblogos*5.5mm + (\pfetsi@nblogos-1)*2.5mm)/2
           - (\pfetsi@k-1)*8mm})
          {\includegraphics[height=5.5mm]{\pfetsi@f}};
      }
    \fi
  \end{tikzpicture}%
}
\newcommand{\diapotitre}{%
  {\setbeamertemplate{background canvas}{\pfetsi@fondtitre}%
   \begin{frame}[plain, noframenumbering]
     \hfill
     \begin{minipage}[c]{0.5\paperwidth-16mm}
       {\usebeamercolor[fg]{structure}\large\bfseries Plan\par}
       \vspace{4mm}
       \tableofcontents
       \pfetsi@alerte
     \end{minipage}
   \end{frame}}%
}

% Diapositive de clôture
\newcommand{\diapoquestions}[1][Merci de votre attention]{%
  {\setbeamercolor{background canvas}{bg=tsiBleu}%
   \begin{frame}[plain, noframenumbering]
     \centering\color{white}
     {\Large\bfseries #1\par}
     \vspace{5mm}
     {\large Questions ?\par}
   \end{frame}}%
}

% Diapositives de transition (option « intercalaires »)
\ifpfetsi@intercalaires
  \AtBeginSection{%
    {\setbeamercolor{background canvas}{bg=tsiBleu}%
     \begin{frame}[plain, noframenumbering]
       \color{white}
       {\Huge\bfseries\color{tsiJaune}\insertsectionnumber\par}
       \vspace{2mm}
       {\LARGE\bfseries\insertsectionhead\par}
     \end{frame}}}
\fi

% ---------------------------------------------------------------------
% Annexes : \annexes remplace \appendix ; les diapositives suivantes ne
% sont ni comptées dans le total ni dans la barre de progression.
% ---------------------------------------------------------------------
\newcommand{\annexes}{\appendix\pfetsi@annexetrue}

\endinput
